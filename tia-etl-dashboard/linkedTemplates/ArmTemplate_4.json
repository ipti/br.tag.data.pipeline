										}
									},
									{
										"source": {
											"name": "FORNECEDOR_CPF",
											"type": "String",
											"physicalType": "VarChar"
										},
										"sink": {
											"name": "FORNECEDOR_CPF",
											"type": "String",
											"physicalType": "char"
										}
									},
									{
										"source": {
											"name": "ordem",
											"type": "Int32",
											"physicalType": "Int32"
										},
										"sink": {
											"name": "ordem",
											"type": "Int32",
											"physicalType": "int"
										}
									},
									{
										"source": {
											"name": "data",
											"type": "DateTime",
											"physicalType": "Date"
										},
										"sink": {
											"name": "DataDePagamentoDaOrdem",
											"type": "DateTime",
											"physicalType": "date"
										}
									},
									{
										"source": {
											"name": "valor",
											"type": "Decimal",
											"physicalType": "NewDecimal"
										},
										"sink": {
											"name": "ValorPagoNaOrdem",
											"type": "Decimal",
											"physicalType": "decimal",
											"scale": 2,
											"precision": 18
										}
									}
								],
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
