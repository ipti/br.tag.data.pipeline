FROM apache/airflow:3.1.0

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       curl \
       gnupg \
       unixodbc-dev \
       build-essential \
       libpq-dev \
       default-mysql-client \
       libmysqlclient-dev \
       pkg-config \
       git \
    && curl https://packages.microsoft.com/keys/microsoft.asc | apt-key add - \
    && curl https://packages.microsoft.com/config/debian/11/prod.list > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y msodbcsql18 \
    && rm -rf /var/lib/apt/lists/*

USER airflow

ENV ODBC_DRIVER_18_FOR_SQL_SERVER=/opt/microsoft/msodbcsql18/lib64/libmsodbcsql-18.1.so.1.1

RUN curl -o /tmp/constraints.txt "https://raw.githubusercontent.com/apache/airflow/constraints-3.1.0/constraints-3.12.txt"

COPY requirements.txt /tmp/requirements.txt

# Step 1: Airflow providers + drivers — pinned by constraints (fast, no resolution needed)
RUN pip install --no-cache-dir \
    apache-airflow-providers-mysql \
    apache-airflow-providers-odbc \
    apache-airflow-providers-common-messaging \
    pyodbc pymysql \
    neo4j apache-airflow-providers-neo4j \
    adlfs azure-storage-blob apache-airflow-providers-microsoft-azure \
    -c /tmp/constraints.txt

COPY requirements-locked.txt /tmp/requirements-locked.txt

# Step 2: ML/AI packages
RUN pip install --no-cache-dir \
    sphinx sphinx-autoapi sphinx-rtd-theme \
    scikit-learn xgboost lightgbm shap \
    mlflow \
    sentence-transformers \
    langchain openai langchain-neo4j \
    evidently \
    "pyarrow>=14.0.0" "pandas<3.0.0" \
    -c /tmp/requirements-locked.txt
