				"typeProperties": {
					"source": {
						"type": "MySqlSource",
						"query": "select\n\tc2.nome as CONTRATO,\n\tf.nome as FORNECEDOR,\n\ttdc.nome as \"TIPO DE CONTRATO\",\n\tF.respresentante_legal as \"REPRESENTANTE LEGAL\",\n\tr.descricao as RUBRICA,\n\trf.parcelas as PARCELAS,\n\tRF.data_inicial as `DATA INICIAL`,\n\tRF.data_final as `DATA FINAL`,\n\trf.valor_total as \"VALOR TOTAL\",\n\trf.workload as \"QUANTIDADE DE HORAS\",\n\trf.unitary_value as \"VALOR UNITÁRIO\",\n\tc2.apoiadora as 'APOIADOR',\n\tcdc.valor_total as 'VALOR TOTAL DOADO PELO APOIADOR',\n\tc2.origem_publica as 'ORIGEM PUBLICA',\n\tc.nome as 'Categoria Dos Gastos',\n\trf.ordem as RUBRICA_FORNECEDORES_ORDEM,\n\tf.cnpj as FORNECEDOR_CNPJ,\n\tf.cpf as FORNECEDOR_CPF,\n\ta.ordem,\n\ta.data,\n\ta.valor\nfrom\n\tfornecedor f\njoin rubrica_fornecedores rf on\n\tf.id = rf.fornecedor_fk\njoin rubrica r on\n\trf.rubrica_fk = r.id\njoin tipo_de_contrato tdc on\n\ttdc.id = f.tipo_de_contrato_fk\njoin categoria c on\n\tc.id = r.categoria_fk\njoin centro_de_custo cdc on\n\tcdc.id = r.centro_de_custo_fk\njoin contrato c2 on\n\tcdc.contrato_fk = c2.id\njoin atividade a on\n\ta.rubrica_fornecedores_fk = rf.id\norder by\n\ttrim(c2.nome) asc,\n\ttrim(f.nome) asc,\n\trf.data_final"
					},
					"sink": {
						"type": "AzureSqlSink",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false
					},
					"enableStaging": false,
