									"query": {
										"value": "select concat(sr.id, '-', se.school_inep_id_fk, '-', si.id) as 'HASH-ID',\nSR.id as \"F_HASH_ID\",\nsr.celiac , sr.diabetes , sr.hypertension , sr.iron_deficiency_anemia , sr.lactose_intolerance , sr.malnutrition ,\nsr.malnutrition , sr.obesity , sr.sickle_cell_anemia , sr.`others` , sr.updated_at, now() as inserted_at, sr.updated_at \nfrom `@{item().DatabaseName}`.student_identification si\nleft join `@{item().DatabaseName}`.student_enrollment se on si.id = se.student_fk\nleft join `@{item().DatabaseName}`.student_restrictions sr on si.id = sr.student_fk\nleft join `@{item().DatabaseName}`.school_identification si2 on se.school_inep_id_fk = si2.inep_id\nwhere si.id and se.school_inep_id_fk is not null and si.id is not null and sr.id is not null\ngroup by sr.celiac , sr.diabetes , sr.hypertension , sr.iron_deficiency_anemia , sr.lactose_intolerance , sr.malnutrition ,\nsr.malnutrition , sr.obesity , sr.sickle_cell_anemia , sr.`others`;",
