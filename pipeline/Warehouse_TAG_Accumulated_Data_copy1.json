										"value": "select concat (si.id, '-', se.school_inep_id_fk,'-' ,gr.discipline_fk,'-',se.classroom_fk) as 'HASH-ID', ed.name,\ngr.updated_at , gr.situation, gr.grade_1, gr.grade_2, gr.grade_3, gr.grade_4, gr.sem_rec_partial_1 ,gr.sem_rec_partial_2,gr.rec_partial_1 , gr.rec_partial_2 , gr.rec_partial_3 , gr.rec_partial_4, now() as inserted_at, gr.id as \"F_HASH_ID\"\nfrom `@{item().DatabaseName}`.student_identification si\nleft join `@{item().DatabaseName}`.student_enrollment se on si.id = se.student_fk\nleft join `@{item().DatabaseName}`.grade_results gr on se.student_fk = gr.enrollment_fk\nleft join `@{item().DatabaseName}`.edcenso_discipline ed on gr.discipline_fk = ed.id\nWHERE si.id IS NOT NULL\n  AND se.school_inep_id_fk IS NOT NULL\n  AND gr.discipline_fk IS NOT NULL\n  AND se.classroom_fk IS NOT NULL\n  AND (gr.grade_1 IS NOT NULL\n       OR gr.grade_2 IS NOT NULL\n       OR gr.grade_3 IS NOT NULL\n       OR gr.grade_4 IS NOT NULL)\n  order by si.id;",
										"type": "Expression"
