							"typeProperties": {
								"source": {
									"type": "MySqlSource",
									"query": {
										"value": "select CONCAT(si.id, '-', se.school_inep_id_fk,'-' ,se.classroom_fk, '-',si2.cep) AS 'HASH-ID',\nconcat (si.id, '-', se.school_inep_id_fk) as student_id, concat (se.classroom_fk, '-', se.school_inep_id_fk) as classroom_id,\nconcat(se.school_inep_id_fk, '-', si2.cep) as school_id,\nconcat(sr.id, '-', se.school_inep_id_fk) as health_id, si.updated_at,\nNOW() as 'inserted_at',\n'@{item().DatabaseName}' AS `db_name`, \n'tagDatabase' as data_origin,\n   (CASE\n        WHEN se.status = '1' THEN 'ATIVO'\n        WHEN se.status = '2' THEN 'TRANSFERIDO'\n        WHEN se.status = '3' THEN 'CANCELADO'\n        WHEN se.status = '4' THEN 'ABANDONADO'\n        WHEN se.status = '5' THEN 'RESTAURADO'\n        WHEN se.status = '6' THEN 'APROVADO'\n        WHEN se.status = '7' THEN 'APROVADO_PELO_CONSELHO'\n        WHEN se.status = '8' THEN 'REPROVADO'\n        WHEN se.status = '9' THEN 'CONCLUÍDO'\n        WHEN se.status = '10' THEN 'INDETERMINADO'\n        WHEN se.status = '11' THEN 'FALECIMENTO'\n        ELSE NULL\n    END) AS `enrollment_status`\nfrom `@{item().DatabaseName}`.student_identification si\nleft join `@{item().DatabaseName}`.student_enrollment se on si.id = se.student_fk\nleft join `@{item().DatabaseName}`.student_restrictions sr on si.id = sr.student_fk\nleft join `@{item().DatabaseName}`.school_identification si2 on se.school_inep_id_fk = si2.inep_id\nWHERE si.id IS NOT NULL\nAND se.school_inep_id_fk IS NOT NULL\nAND se.classroom_fk IS NOT NULL\nAND si2.cep IS NOT NULL\ngroup by si.id, se.classroom_fk, se.school_inep_id_fk, se.classroom_fk\norder by si.id;",
