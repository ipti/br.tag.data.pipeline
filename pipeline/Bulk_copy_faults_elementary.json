					"batchCount": 3,
					"activities": [
						{
							"name": "D_STUDENT_FAULTS_ELEMENTAR",
							"type": "Copy",
							"state": "Inactive",
							"onInactiveMarkAs": "Succeeded",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "MySqlSource",
									"query": {
										"value": "SELECT\n\tCONCAT(MIN(t.id), '-', c.id, '-', se.school_inep_id_fk) AS 'class_id',\n\tCONCAT(MIN(t.id), '-', c.id, '-', se.school_inep_id_fk, '-', si.id) AS 'HASH-ID',\n    t.id as 'F_HASH_ID' ,\n    now() as inserted_at,\n    'elementary school' as discipline_id,\n\tconcat(si.id, '-', se.school_inep_id_fk,'-' ,se.classroom_fk) as student_id,\n    t.updated_at,\n    COUNT(DISTINCT t.day) AS scheduled_student_class_days,\n    COUNT(DISTINCT CASE WHEN cf.id IS NOT NULL THEN t.day END) AS total_faults_per_day\nFROM `@{item().DatabaseName}`.schedule t\nJOIN `@{item().DatabaseName}`.classroom c ON c.id = t.classroom_fk\nJOIN `@{item().DatabaseName}`.edcenso_stage_vs_modality svm ON svm.id = c.edcenso_stage_vs_modality_fk\nJOIN `@{item().DatabaseName}`.student_enrollment se ON se.classroom_fk = t.classroom_fk\nJOIN `@{item().DatabaseName}`.student_identification si ON se.student_fk = si.id\nJOIN `@{item().DatabaseName}`.student_documents_and_address sd ON sd.id = si.id\nLEFT JOIN `@{item().DatabaseName}`.class_faults cf ON cf.student_fk = si.id AND cf.schedule_fk = t.id\nleft join `@{item().DatabaseName}`.grade_results gr on se.student_fk = gr.enrollment_fk\nWHERE t.unavailable = 0\nGROUP BY c.id, si.id, t.month;",
										"type": "Expression"
									}
								},
								"sink": {
									"type": "AzureSqlSink",
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"mappings": [
										{
											"source": {
												"name": "class_id"
											},
