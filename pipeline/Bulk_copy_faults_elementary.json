						{
							"name": "F_CLASS_ELEMENTARY",
							"type": "Copy",
							"state": "Inactive",
							"onInactiveMarkAs": "Succeeded",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "MySqlSource",
									"query": {
										"value": "SELECT\n\tCONCAT(MIN(t.id), '-', c.id, '-', se.school_inep_id_fk, '-',si2.cep) as 'HASH_ID', \n\tCONCAT(MIN(t.id), '-', c.id, '-', se.school_inep_id_fk) AS 'class_id', -- Pega o primeiro t.id vinculado ao c.id\n\tconcat (se.classroom_fk, '-', se.school_inep_id_fk) as 'classroom_id',\n\tconcat(se.school_inep_id_fk, '-', si2.cep) as school_id,\n\tconcat(itd.instructor_fk, '-', c.id, '-', se.school_inep_id_fk) as 'teacher_id',\n    t.id as 'F_HASH_ID' ,\n    c.name,\n    t.`month` ,\n    c.school_year ,\n    now() as inserted_at,\n    t.updated_at as updated_at,\n    'elementary school' as discipline_id,\n    COUNT(DISTINCT t.day) AS scheduled_student_class_days\nFROM `@{item().DatabaseName}`.schedule t\nJOIN `@{item().DatabaseName}`.classroom c ON c.id = t.classroom_fk\nJOIN `@{item().DatabaseName}`.edcenso_stage_vs_modality svm ON svm.id = c.edcenso_stage_vs_modality_fk\nJOIN `@{item().DatabaseName}`.student_enrollment se ON se.classroom_fk = t.classroom_fk\nJOIN `@{item().DatabaseName}`.student_identification si ON se.student_fk = si.id\nJOIN `@{item().DatabaseName}`.student_documents_and_address sd ON sd.id = si.id\nLEFT JOIN `@{item().DatabaseName}`.class_faults cf ON cf.student_fk = si.id AND cf.schedule_fk = t.id\nleft join `@{item().DatabaseName}`.grade_results gr on se.student_fk = gr.enrollment_fk\nleft join `@{item().DatabaseName}`.instructor_teaching_data itd on c.id = itd.classroom_id_fk and se.school_inep_id_fk = itd.school_inep_id_fk \nleft join `@{item().DatabaseName}`.school_identification si2 on se.school_inep_id_fk = si2.inep_id\nWHERE t.unavailable = 0 and c.id is not null and t.id is not null and se.school_inep_id_fk is not null\nGROUP BY c.id, t.month\norder by c.id;",
										"type": "Expression"
									}
								},
